# Patch /etc/ettercap/etter.conf so ARP poisoning runs as root and the
# SSL/redirect helpers actually fire. Apply once, on the attacker VM.
#
#     sudo patch /etc/ettercap/etter.conf < project/ettercap/etter.conf.patch
#
# The two lines to change are the [privs] block (drop 65534 -> 0) and the
# redir_command_on / redir6_command_on lines under [redir].

--- /etc/ettercap/etter.conf.orig
+++ /etc/ettercap/etter.conf
@@
-[privs]
-ec_uid = 65534                # nobody is the default
-ec_gid = 65534                # nobody is the default
+[privs]
+ec_uid = 0                    # run as root so raw sockets + iptables work
+ec_gid = 0
@@
-#redir_command_on = "iptables -t nat -A PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
-#redir_command_off = "iptables -t nat -D PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
+redir_command_on  = "iptables -t nat -A PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
+redir_command_off = "iptables -t nat -D PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
@@
-#redir6_command_on = "ip6tables -t nat -A PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
-#redir6_command_off = "ip6tables -t nat -D PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
+redir6_command_on  = "ip6tables -t nat -A PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
+redir6_command_off = "ip6tables -t nat -D PREROUTING -i %iface -p tcp --dport %port -j REDIRECT --to-port %rport"
